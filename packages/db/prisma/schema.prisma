generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------

enum Role {
  BUYER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AuctionStatus {
  DRAFT
  LIVE
  ENDED
  CANCELLED
  FLAGGED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID_ESCROW
  SHIPPED
  RECEIVED_CONFIRMED
  PAYOUT_REQUESTED
  PAYOUT_COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum Gateway {
  STRIPE
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

// ------------------------------------------------------------------
// MODELS
// ------------------------------------------------------------------

enum EmailOtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  fullName         String
  organization     String?
  phone            String?
  bio              String?
  emailVerified    Boolean   @default(false)
  role             Role
  kycStatus        KycStatus @default(UNVERIFIED)
  kycDocumentUrls  String[]  @default([])
  avatarUrl        String?
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  isActive         Boolean   @default(true)
  createdByAdmin   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // seller-only
  bankAccount BankAccount?
  listings    Auction[]    @relation("SellerListings")

  // buyer-only
  bids      Bid[]
  cart      Cart?
  orders    Order[]     @relation("BuyerOrders")
  watchlist Watchlist[]

  notifications Notification[]
  addresses     Address[]
  reviewsGiven     Review[] @relation("ReviewsGiven")
  reviewsReceived  Review[] @relation("ReviewsReceived")

  @@index([role])
  @@map("users")
}

model BankAccount {
  id              String   @id @default(cuid())
  sellerId        String   @unique
  seller          User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  accountName     String
  accountNumber   String
  bankName        String
  routingOrBranch String
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bank_accounts")
}

model Auction {
  id            String        @id @default(cuid())
  sellerId      String
  seller        User          @relation("SellerListings", fields: [sellerId], references: [id])
  title         String
  slug          String        @unique
  description   String
  category      String
  condition     String
  images        String[]
  startingBid   Decimal       @db.Decimal(12, 2)
  reservePrice  Decimal?      @db.Decimal(12, 2)
  buyNowPrice   Decimal?      @db.Decimal(12, 2)
  currentBid    Decimal       @default(0) @db.Decimal(12, 2)
  minIncrement  Decimal       @default(100) @db.Decimal(12, 2)
  status        AuctionStatus @default(DRAFT)
  antiSnipe     Boolean       @default(false)
  startsAt      DateTime
  endsAt        DateTime
  reserveMet    Boolean       @default(false)
  winnerId      String?
  soldViaBuyNow Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bids      Bid[]
  watchers  Watchlist[]
  flags     AuctionFlag[]
  cartItems CartItem[]
  order     Order?

  @@index([status])
  @@index([sellerId])
  @@map("auctions")
}

model Bid {
  id          String   @id @default(cuid())
  auctionId   String
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId    String
  bidder      User     @relation(fields: [bidderId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  isProxy     Boolean  @default(false)
  maxProxyAmt Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([auctionId])
  @@map("bids")
}

model Cart {
  id      String     @id @default(cuid())
  buyerId String     @unique
  buyer   User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items   CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  addedAt   DateTime @default(now())

  @@unique([cartId, auctionId])
  @@map("cart_items")
}

// One Order per completed sale — escrow + fulfillment record
model Order {
  id                  String      @id @default(cuid())
  auctionId           String      @unique
  auction             Auction     @relation(fields: [auctionId], references: [id])
  buyerId             String
  buyer               User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  finalAmount         Decimal     @db.Decimal(12, 2)
  platformFeePct      Decimal     @default(5.0) @db.Decimal(5, 2)
  platformFeeAmt      Decimal     @db.Decimal(12, 2)
  sellerPayoutAmt     Decimal     @db.Decimal(12, 2)
  status              OrderStatus @default(AWAITING_PAYMENT)
  paidAt              DateTime?
  shippedAt           DateTime?
  receivedConfirmedAt DateTime?
  payoutRequestedAt   DateTime?
  payoutCompletedAt   DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  payment Payment?
  payout  Payout?
  reviews Review[]

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

model Review {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("ReviewsReceived", fields: [toUserId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([orderId, fromUserId])
  @@index([toUserId])
  @@map("reviews")
}

model EmailOtp {
  id         String          @id @default(cuid())
  email      String
  codeHash   String
  purpose    EmailOtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([email, purpose])
  @@map("email_otps")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway     Gateway
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("payments")
}

// Seller-initiated withdrawal request against a RECEIVED_CONFIRMED order
model Payout {
  id          String       @id @default(cuid())
  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId    String
  amount      Decimal      @db.Decimal(12, 2)
  status      PayoutStatus @default(REQUESTED)
  approvedBy  String?
  requestedAt DateTime     @default(now())
  paidAt      DateTime?

  @@index([sellerId])
  @@index([status])
  @@map("payouts")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, auctionId])
  @@map("watchlist")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model AuctionFlag {
  id         String    @id @default(cuid())
  auctionId  String
  auction    Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  reason     String
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("auction_flags")
}

model Address {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1   String
  city    String
  state   String
  country String

  @@map("addresses")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_inquiries")
}
