# --- Database (Neon) ---
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/eams?sslmode=require"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# --- Stripe (test mode: https://dashboard.stripe.com/test/apikeys) ---
# Paste sk_test_... and pk_test_... from your Stripe account. Placeholders will not work.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# --- SSLCommerz sandbox (official test store) ---
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASSWORD="qwerty"
SSLCOMMERZ_IS_LIVE="false"
USD_TO_BDT_RATE="130"

# --- App ---
API_PORT=4000
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4000"
PLATFORM_FEE_PCT=5

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- Email ---
# Local: Gmail SMTP + App Password works on your machine.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@example.com"
SMTP_PASS="your_app_password"
SMTP_FROM="e-AMS <you@example.com>"

# Production (Render): Gmail SMTP is blocked. Use Resend over HTTPS instead.
# 1. Create a free account at https://resend.com
# 2. Create an API key
# 3. Set RESEND_API_KEY on the Render API service and redeploy
# Optional: after verifying a domain on Resend, set RESEND_FROM="e-AMS <noreply@yourdomain.com>"
RESEND_API_KEY=""
RESEND_FROM=""

# --- Next.js public ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
